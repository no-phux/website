---
import "../styles/global.css";
import Head from "../components/Head.astro";
import GitHubBadge from "../components/GitHubBadge.astro";
import Consent from "../components/Consent.astro";
import { SITE, NAV, docsHref } from "../lib/site";
import brand from "../../brand.lock.json";
import { Wordmark } from "../components/Wordmark";

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  minimal = false,
} = Astro.props;

const path = Astro.url.pathname;
// The landing carries a short top bar of its own; the rest of the site uses
// the full marketing nav.
const navigation = minimal ? [
  { href: docsHref("/overview"), label: "Docs" },
] : NAV;
---

<!doctype html>
<html lang="en" data-design={SITE.designMode} data-home={minimal || undefined}>
  <head>
    <Head title={title} description={description} type="website" />
    {minimal && <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-frame">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label={SITE.name}>{minimal ? <span class="home-wordmark"><picture><source srcset={`/brand/images/mark-dark.svg?v=${brand.version}`} media="(prefers-color-scheme: light)" /><img src={`/brand/images/mark.svg?v=${brand.version}`} width="42" height="42" alt="" /></picture><Wordmark decorative /></span> : <><img class="brand-fox" src={`/favicon.svg?v=${brand.version}`} alt="" width="32" height="32" /><Wordmark decorative /></>}</a>
        <div class="links">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={
                  !("external" in item && item.external) && path.startsWith(item.href)
                    ? "page"
                    : undefined
                }
                {...("external" in item && item.external
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                {item.label}
              </a>
            ))
          }
          {minimal && <GitHubBadge quiet />}
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-frame">
      {minimal ? (
        <div class="quiet-foot">
          <span>Open source · Apache-2.0</span>
          <nav aria-label="More about phux">
            <a href="/demos">Demos</a>
            <a href="/concepts/vgpu" title="Explore the phux light lab">Concepts</a>
            <a href="/more">More</a>
            <a href="/teams">Teams</a>
            <a href="/privacy">Privacy</a>
            <button type="button" class="privacy-choices" data-consent-open>Privacy choices</button>
          <a href="/brand">Brand assets</a>
            <a href="/support">Support</a>
            <a href="https://x.com/phall249" target="_blank" rel="me noopener">@phall249 on X</a>
          </nav>
        </div>
      ) : <><div class="foot">
        <div class="foot-brand">
          <a class="brand" href="/" aria-label={SITE.name}><img class="brand-fox" src={`/favicon.svg?v=${brand.version}`} alt="" width="32" height="32" /><Wordmark decorative /></a>
          <p>{SITE.tagline}</p>
        </div>
        <nav class="foot-col" aria-label="Product">
          <h2>Product</h2>
          <a href="/demos">Demos</a>
          <a href="/concepts/vgpu" title="Explore the phux light lab">Concepts</a>
          <a href={docsHref("/getting-started")}>CLI</a>
          <a href={docsHref("/clients")}>Desktop</a>
          <a href={docsHref("/clients")}>Web</a>
          <a href={docsHref("/agents")}>Agents</a>
          <a href="/teams">Teams</a>
        </nav>
        <nav class="foot-col" aria-label="Docs">
          <h2>Docs</h2>
          <a href={docsHref("/overview")}>Overview</a>
          <a href={docsHref("/getting-started")}>Quickstart</a>
          <a href={docsHref("/installation")}>Install</a>
          <a href={docsHref("/protocol")}>Protocol</a>
        </nav>
        <nav class="foot-col" aria-label="Project">
          <h2>Project</h2>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.gg/dUv5rzdHp" target="_blank" rel="noopener">Discord</a>
          <a href="https://x.com/phall249" target="_blank" rel="me noopener">@phall249 on X</a>
          <a href={SITE.github + "/blob/main/LICENSE"} target="_blank" rel="noopener">Apache-2.0</a>
          <a href="/privacy">Privacy</a>
          <button type="button" class="privacy-choices" data-consent-open>Privacy choices</button>
          <a href="/brand">Brand assets</a>
          <a href="/support">Support</a>
        </nav>
      </div>
      <p class="foot-end">© 2026 no-phux</p></>}
    </footer>
    <Consent />
  </body>
</html>

<style>
  /* The landing reads the same brand tokens as the rest of marketing; only its
     layout constants and the quiet ground light differ. */
  :global(html[data-home]) {
    --content-wide: 1240px;
    --page-gutter: clamp(20px, 3vw, 40px);
    --fox-halo: var(--phux-wash-hover);
    -webkit-font-smoothing: antialiased;
  }
  :global(html[data-home]) body { background: radial-gradient(ellipse 1000px 600px at 85% 0%, var(--phux-wash-hover), transparent 70%), var(--color-bg); }
  :global(html[data-home]) .nav { height: 82px; border-bottom: var(--phux-space-hairline) solid var(--phux-border-muted); }
  :global(html[data-home]) .nav .links { gap: 30px; }
  :global(html[data-home]) .nav .links a { display: inline-flex; align-items: center; justify-content: center; min-width: var(--phux-space-touch-min); min-height: var(--phux-space-touch-min); }
  .home-wordmark { display: inline-flex; align-items: center; gap: var(--phux-space-s2); color: var(--color-fg); font-size: var(--phux-type-display-size); font-weight: var(--phux-weight-semibold); letter-spacing: -.05em; }
  .home-wordmark picture, .home-wordmark img { display: block; width: 42px; height: 42px; }
  .quiet-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--phux-space-s3) var(--phux-space-s6); border-top: var(--phux-space-hairline) solid var(--color-rule); padding-block: var(--phux-space-s5) var(--phux-space-s8); color: var(--color-dim); font-size: var(--phux-type-caption-size); }
  .quiet-foot nav { display: flex; flex-wrap: wrap; gap: var(--phux-space-s5); }
  .quiet-foot a, .quiet-foot .privacy-choices { display: inline-flex; align-items: center; min-height: var(--phux-space-touch-min); }
  @media (max-width: 560px) {
    :global(html[data-home]) .nav { flex-wrap: nowrap; gap: var(--phux-space-s4); }
    :global(html[data-home]) .nav .links { flex-basis: auto; flex-wrap: nowrap; margin-inline-start: auto; gap: var(--phux-space-s3); }
  }
  /* Keep the full primary navigation readable and reachable on small screens. */
  @media (max-width: 560px) {
    .nav {
      height: auto;
      flex-wrap: wrap;
      gap: var(--phux-space-s1) var(--phux-space-s5);
      padding-block: 10px;
    }
    .nav .links {
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 0 14px;
      margin-inline-start: 0;
    }
    .nav .brand,
    .nav .links a {
      display: inline-flex;
      align-items: center;
      min-height: var(--phux-space-touch-min);
      padding-inline: 0;
    }
    .nav .links a {
      font-size: var(--phux-type-body-size);
    }
  }
</style>
