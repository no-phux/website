---
import { SITE } from "../lib/site";
interface Props { quiet?: boolean; }
const { quiet = false } = Astro.props;
---
<a class:list={["github-badge", { "is-quiet": quiet }]} href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub — phux source code">
  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.2.8-.5v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.4-1.3-5.4-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3 0 0 1-.3 3.1 1.2a10.8 10.8 0 0 1 5.7 0c2.2-1.5 3.1-1.2 3.1-1.2.6 1.5.2 2.7.1 3 .8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.4 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.6.8.5A11.4 11.4 0 0 0 12 .8Z" /></svg>
  <span>GitHub</span><span class="badge-source" aria-hidden="true">Source ↗</span>
</a>
<style>
  .github-badge { display: inline-flex; align-items: center; gap: var(--phux-space-s2); min-height: 36px; padding: 0 11px; border: var(--phux-space-hairline) solid var(--phux-border-base); border-radius: var(--phux-radius-md); color: var(--phux-text-text); font: var(--phux-weight-medium) var(--phux-type-caption-size)/1 var(--font-reading); white-space: nowrap; transition: border-color var(--phux-motion-control-duration) var(--phux-motion-control-easing), background var(--phux-motion-control-duration) var(--phux-motion-control-easing); }
  .github-badge:hover { border-color: var(--phux-border-strong); background: var(--phux-wash-hover); color: var(--phux-text-text); }
  .github-badge:focus-visible { outline: var(--phux-focus-ring-width) solid var(--phux-border-focus); outline-offset: var(--phux-focus-ring-offset); }
  .badge-source { border-inline-start: var(--phux-space-hairline) solid var(--phux-border-base); padding-inline-start: var(--phux-space-s2); color: var(--phux-text-dim); font-size: var(--phux-type-micro-size); }
  .github-badge.is-quiet { min-height: 44px; padding: 0; border: 0; color: var(--phux-text-dim); background: none; font-size: var(--phux-type-label-size); }
  .github-badge.is-quiet .badge-source { display: none; }
  .github-badge.is-quiet:hover { color: var(--phux-text-text); }
  @media (max-width: 600px) { .github-badge { min-height: 44px; padding-inline: 9px; } .badge-source { display: none; } }
  @media (prefers-reduced-motion: reduce) { .github-badge { transition: none; } }
</style>
