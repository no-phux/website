---
// Shared <head> contents — BaseLayout and DocsLayout both render this so
// canonical/OG/Twitter behavior can't drift between the landing and the docs.
import { HOME, SITE } from "../lib/site";
import { softwareApplicationJson } from "../lib/software-application";
import brand from "../../brand.lock.json";

interface Props {
  title: string;
  description: string;
  /** og:type — "website" for the landing, "article" for docs pages. */
  type?: "website" | "article";
  /** Canonical origin. Docs pages pass docs.phux.sh; marketing stays on phux.sh. */
  origin?: string;
  /** Site-relative social card for this page; defaults to the product card. */
  image?: string;
}

const { title, description, type = "website", origin = SITE.url, image } = Astro.props;

// build.format "file" leaves ".html" on build-time pathnames; the served
// routes are extensionless (trailingSlash "never"), so canonicals must be too.
const path =
  Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "").replace(/\/+$/, "") ||
  "/";
const canonical = new URL(path, origin).href;
const previewIdentity = encodeURIComponent(
  `${SITE.name}|${SITE.category}|${SITE.tagline}|${SITE.previewArtwork}|${brand.version}`,
);
const ogUrl = new URL(image ?? "/og.png", image ? origin : SITE.url);
ogUrl.searchParams.set("v", previewIdentity);
const ogImage = ogUrl.href;
const ogAlt = image ? title : `${SITE.name}: ${HOME.headline} Real desktop and terminal workspace screenshots.`;
const jsonLd = softwareApplicationJson();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta property="og:image:alt" content={ogAlt} />
{origin === SITE.docsUrl ? (
  <>
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121311" media="(prefers-color-scheme: dark)" />
  </>
) : <meta name="theme-color" content="#07080b" />}
<link rel="icon" href={`/favicon.svg?v=${brand.version}`} type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<script is:inline type="application/ld+json" set:html={jsonLd} />
