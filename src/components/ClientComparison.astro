---
const clients = [
  { id: "gui", label: "Desktop", src: "/product/desktop.webp", width: 1920, height: 1222, alt: "Real Phux desktop Agent Fleet showing working agents and an agent ready for review." },
  { id: "tui", label: "TUI", src: "/product/tui.webp", width: 1440, height: 896, alt: "Real phux terminal UI with a split workspace, passing tests, and agent commands." },
];
---
<div class="client-comparison" data-comparison aria-label="Phux terminal and desktop screenshots">
  {clients.map(client => (
    <figure class={`client-${client.id}`}>
      <a href={client.src} data-product-image aria-label={`Enlarge ${client.label} screenshot`}>
        <img src={client.src} width={client.width} height={client.height} alt={client.alt} loading="eager" fetchpriority="high" />
      </a>
      <figcaption>{client.label}</figcaption>
    </figure>
  ))}
</div>
<dialog class="product-image" aria-label="Product screenshot">
  <button type="button" aria-label="Close screenshot">×</button>
  <img alt="" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".product-image")!;
  const image = dialog.querySelector("img")!;
  document.querySelectorAll<HTMLAnchorElement>("[data-product-image]").forEach(link => {
    link.addEventListener("click", event => {
      // Keep the direct image link for modified clicks and no-JS visitors.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      image.src = link.href;
      image.alt = link.querySelector("img")!.alt;
      dialog.showModal();
    });
  });
  dialog.querySelector("button")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
</script>
<style>
  .client-comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 32px 0 24px; text-align: left; }
  figure { min-width: 0; margin: 0; }
  figure a { display: block; overflow: hidden; border: 1px solid #c2d6e32a; border-radius: 12px; background: #080d10; box-shadow: 0 20px 64px #0004; cursor: zoom-in; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 1440 / 914; object-fit: contain; }
  figcaption { margin-top: 10px; text-align: center; font-size: 12px; color: #aebbc2; }
  .product-image { width: min(1440px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px); padding: 44px 12px 12px; border: 1px solid #c2d6e32a; border-radius: 14px; background: #101517; color: #eee; }
  .product-image::backdrop { background: #000d; }
  .product-image img { display: block; max-width: 100%; max-height: calc(100dvh - 104px); margin: auto; object-fit: contain; }
  .product-image button { position: absolute; top: 0; right: 4px; width: 44px; height: 44px; border: 0; background: none; color: inherit; font: 28px var(--font-reading); cursor: pointer; }
  @media (max-width: 600px) {
    .client-comparison { display: flex; gap: 12px; margin: 24px -20px; padding: 0 20px 8px; overflow-x: auto; scroll-snap-type: x mandatory; }
    figure { flex: 0 0 88%; scroll-snap-align: center; }
    figure a { border-radius: 8px; }
    figcaption { font-size: 12px; }
  }
</style>
