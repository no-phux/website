---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthReturn from "../components/AuthReturn.astro";
import HeroDemo from "../components/HeroDemo";
import ClientComparison from "../components/ClientComparison.astro";
import Fox from "../components/fox/Fox.astro";
import MobileAccessForm from "../components/MobileAccessForm.astro";
import LiveWorkspaceSection from "../components/LiveWorkspaceSection.astro";
import Exhibits from "../components/Exhibits.astro";
import { HOME, SITE, docsHref } from "../lib/site";
import { cliInstall, desktopInstall, installTargets, linuxArchLabels, linuxArches, runeDockNote, runeDownload, runeInstall, runeLinuxDownload } from "../lib/install";
import release from "../lib/release.json";
import brand from "../../brand.lock.json";
import { installActions } from "../lib/home-platform";
const installs = installTargets;
const fallback = installActions.unknown;
---

<BaseLayout minimal title={HOME.title} description={HOME.description}>
  <AuthReturn slot="head" />
  <div class="home">
    <section class="hero" aria-labelledby="product-name">
      <div class="hero-intro">
        <div class="hero-copy">
        <h1 id="product-name">{HOME.headline}</h1>
        <div class="hero-decision">
          <p class="hero-description">{HOME.lede}</p>
          <div class="download-actions">
            <a class="download-primary" data-device-install href={fallback.href}><span data-device-label>{fallback.label}</span> <span data-device-icon aria-hidden="true">{fallback.icon}</span></a>
            <a class="try-link" href="#live-workspace" aria-label="Open the browser demo">Try it first <span aria-hidden="true">↗</span></a>
          </div>
          <p class="download-note">{fallback.note}</p>
          <div class="linux-rune" id="linux-rune" data-linux-rune hidden>
            <p class="linux-rune-title">Phux Rune for Linux · desktop app</p>
            <div class="linux-rune-line">
              <span class="install-command"><span class="install-prompt" aria-hidden="true">$</span> <code>{runeInstall}</code></span>
              <button type="button" class="linux-rune-copy" data-linux-copy aria-label="Copy the Rune install command for Linux">Copy</button>
            </div>
            <p class="linux-rune-archives">Or download:
              {linuxArches.map(arch => <a data-linux-archive={arch} href={runeLinuxDownload(arch)}>Linux {linuxArchLabels[arch]} .tar.gz ↓</a>)}
            </p>
            <p class="linux-rune-status" data-linux-status role="status" aria-live="polite"></p>
          </div>
      <details class="install-options" id="install-options"><summary>All platforms</summary>
      <div class="install" id="install" data-install aria-label="Install phux">
        <div class="install-head">
          <div class="install-tabs" role="group" aria-label="Choose an install">
            {installs.map((target, index) => (
              <button
                type="button"
                data-install-target={target.id}
                data-install-command={target.command}
                data-install-note={target.id === "rune" ? runeDockNote : target.note}
                aria-pressed={index === 0 ? "true" : "false"}
              >{target.label}</button>
            ))}
          </div>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <div class="install-stage">
          <div class="install-line">
            <span class="install-command">
              <span class="install-prompt" aria-hidden="true">$</span>
              <code id="install-command">{cliInstall}</code>
            </span>
            <span class="install-download" id="install-download" hidden>
              <a href={runeDownload}>Download for Mac ↓</a>
              {linuxArches.map(arch => <a href={runeLinuxDownload(arch)}>Linux {linuxArchLabels[arch]} ↓</a>)}
            </span>
            <button type="button" class="install-copy" data-copy={cliInstall} aria-label="Copy install command">Copy</button>
          </div>
          <div class="install-request mobile-access" data-mobile-access hidden>
            <MobileAccessForm />
          </div>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <p class="install-note" id="install-note">{installs[0].note}</p>
        <p class="copy-status" id="beta-note" role="status" aria-live="polite"></p>
      </div>
        <p class="release-links">
          {release.url && <a href={release.url}>CLI {release.tag}</a>}
          {release.rune?.url && <a href={release.rune.url}>Rune {String(release.rune.tag ?? "").replace("rune-", "")}</a>}
          <a href={docsHref("/installation")}>Installation guide ↗</a>
        </p>
      </details>
        </div>
        </div>
        <div class="hero-art"><Fox /></div>
      </div>
      <ClientComparison />
    </section>

    <Exhibits />
  </div>

  <LiveWorkspaceSection />

  <section class="closing home" aria-labelledby="closing-title">
    <div class="closing-copy">
      <h2 id="closing-title">Start with one command.</h2>
      <p class="closing-command"><span class="install-prompt" aria-hidden="true">$</span> <code>{cliInstall}</code></p>
      <a class="download-final" data-device-install href={fallback.href}><span data-device-label>{fallback.label}</span> <span data-device-icon aria-hidden="true">{fallback.icon}</span></a>
      <a class="closing-platforms" href={docsHref("/installation")}>All platforms ↗</a>
    </div>
    <img class="closing-fox" src={`/brand/images/mark.svg?v=${brand.version}`} width="340" height="340" alt="" aria-hidden="true" loading="lazy" />
  </section>

  <details class="connection-details home" id="connection-details">
    <summary>How your workspace stays connected <span aria-hidden="true">+</span></summary>
    <section class="terminal" aria-label="How clients share the workspace"><HeroDemo client:visible wsUrl={SITE.demoWsUrl} /></section>
  </details>
  <div hidden data-webmcp data-product={SITE.name} data-cli={cliInstall}
    data-desktop={desktopInstall} data-docs={SITE.docsUrl}
    data-release-tag={release.tag} data-release-url={release.url}></div>
</BaseLayout>

<script>
  import { registerSiteTools, siteModelContext } from "../webmcp.ts";
  import { wireBetaRequest } from "../lib/beta.ts";
  import { wireInstallTargets } from "../lib/home-install";
  import { wireDeviceInstall } from "../lib/home-platform";
  const facts = document.querySelector<HTMLElement>("[data-webmcp]");
  const context = siteModelContext(globalThis);
  if (facts && context) {
    void registerSiteTools(context, {
      productName: facts.dataset.product ?? "", cliInstall: facts.dataset.cli ?? "",
      desktopInstall: facts.dataset.desktop ?? "",
      docsUrl: facts.dataset.docs ?? "", releaseTag: facts.dataset.releaseTag ?? "",
      releaseUrl: facts.dataset.releaseUrl ?? "",
    });
  }
  // A native OAuth return must wake the otherwise visibility-hydrated dialog.
  if (document.documentElement.dataset.nativeAuthResult) {
    document.querySelector<HTMLDetailsElement>("#connection-details")!.open = true;
    document.querySelector(".terminal")?.scrollIntoView({ block: "center", behavior: "instant" });
  }
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>(".copy-status");
  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      if (status) status.textContent = "Install command copied.";
      setTimeout(() => { button.textContent = button.dataset.label ?? "Copy"; }, 1400);
    } catch {
      if (status) status.textContent = "Could not copy. Select the command to copy it manually.";
    }
  });

  // The dock keeps its fixed width and reserves its stage height, so a swap
  // moves nothing. Only the target underline travels (transform), and the
  // command settles with opacity and a short translate. The Mobile target has
  // no command: it swaps the command line for the beta request form. No
  // clip or backdrop animation: both are what made the first pass stutter.
  wireInstallTargets(button);

  wireBetaRequest(
    document.getElementById("beta-form") as HTMLFormElement | null,
    document.getElementById("beta-note"),
  );
  wireDeviceInstall();
</script>

<style>
  /* Every value comes from the brand tokens (src/styles/brand-tokens.css). The
     hero download is the one metal control in view; the closing one is flat. */
  .home { width: min(100%, 1240px); margin-inline: auto; padding-inline: var(--phux-space-s10); box-sizing: border-box; }
  .hero { padding-top: 28px; }
  .hero-intro { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: var(--phux-space-s3); margin-bottom: var(--phux-space-s8); }
  .hero-copy { position: relative; z-index: 1; padding-block: 22px; }
  .hero-art { margin-block: -24px -20px; margin-inline: -36px -38px; pointer-events: none; overflow: clip; }
  h1 { margin: 0 0 22px; max-width: 17ch; color: var(--phux-text-text); font-size: clamp(var(--phux-type-display-size), 4.5vw, 3rem); line-height: 1.08; font-weight: var(--phux-weight-semibold); letter-spacing: -.04em; text-wrap: balance; }
  .hero-description { margin: 0 0 26px; max-width: 44ch; color: var(--phux-text-dim); font-size: clamp(var(--phux-type-lead-size), 1.4vw, 1.125rem); line-height: 1.55; }
  .download-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--phux-space-s3) var(--phux-space-s5); }
  .download-primary, .download-final { display: inline-flex; align-items: center; justify-content: center; gap: 28px; min-height: 56px; padding: 0 var(--phux-space-s6); border: var(--phux-space-hairline) solid var(--phux-border-strong); border-radius: var(--phux-radius-sm); background: var(--phux-accent-accent); color: var(--phux-accent-on-accent); font-size: var(--phux-type-body-size); font-weight: var(--phux-weight-semibold); line-height: 1.2; box-shadow: var(--phux-elevation-raised); transition: background-color var(--phux-motion-control-duration) var(--phux-motion-control-easing), box-shadow var(--phux-motion-control-duration) var(--phux-motion-control-easing), transform var(--phux-motion-press-duration) var(--phux-motion-press-easing); }
  .download-primary { background: var(--phux-metal); }
  .download-primary:hover, .download-final:hover { background: var(--phux-accent-hi); color: var(--phux-accent-on-accent); transform: translateY(-1px); box-shadow: var(--phux-elevation-floating); }
  .download-primary:active, .download-final:active { transform: scale(0.98); box-shadow: var(--phux-elevation-raised); }
  [data-device-icon] { font-size: var(--phux-type-title-size); font-weight: var(--phux-weight-regular); }
  .try-link { display: inline-flex; align-items: center; gap: var(--phux-space-s3); min-height: var(--phux-space-touch-min); color: var(--phux-text-dim); font-size: var(--phux-type-label-size); }
  .try-link:hover { color: var(--phux-text-text); }
  .closing-command code { color: var(--phux-text-text); font-size: var(--phux-type-body-size); overflow-wrap: anywhere; }
  .download-note { margin: var(--phux-space-s3) 0 0; color: var(--phux-text-faint); font-size: var(--phux-type-micro-size); letter-spacing: .01em; }
  .install-options { margin-top: var(--phux-space-s2); }
  .install-options > summary { width: fit-content; min-height: var(--phux-space-touch-min); display: flex; align-items: center; gap: 10px; color: var(--phux-text-dim); font-size: var(--phux-type-caption-size); cursor: pointer; list-style: none; }
  .install-options > summary::after { content: "+"; color: var(--phux-text-faint); }
  .install-options[open] > summary::after { content: "−"; }
  .install-options > summary::-webkit-details-marker { display: none; }
  .install { position: relative; width: 100%; box-sizing: border-box; padding: 14px 18px 0; border: var(--phux-space-hairline) solid var(--phux-border-base); border-radius: var(--phux-radius-md); background: var(--phux-layer-sidebar); }
  .install-tabs { position: relative; display: flex; gap: 6px; }
  .install-tabs::before { content: ""; position: absolute; bottom: -5px; inset-inline-start: 0; width: var(--pill-width, 0); height: var(--phux-space-hairline); background: var(--phux-text-dim); transform: translateX(var(--pill-x, 0)); transition: transform var(--phux-motion-select-duration) var(--phux-motion-select-easing); }
  .install-tabs button { position: relative; min-width: 64px; min-height: var(--phux-space-touch-min); padding: 0 var(--phux-space-s2); border: 0; background: none; color: var(--phux-text-faint); font: inherit; font-size: var(--phux-type-caption-size); cursor: pointer; transition: color var(--phux-motion-control-duration) var(--phux-motion-control-easing); }
  .install-tabs button[aria-pressed=true], .install-tabs button:hover { color: var(--phux-text-text); }
  .install-rule { display: block; height: var(--phux-space-hairline); margin-top: 14px; background: var(--phux-border-muted); }
  .install-stage { display: grid; align-items: center; min-height: 112px; }
  .install-line { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; padding-top: 10px; }
  .install-command { display: flex; gap: var(--phux-space-s2); align-items: start; min-width: 0; }
  .install-prompt { color: var(--phux-text-faint); font-family: var(--font-code); font-size: var(--phux-type-caption-size); }
  #install-command { min-width: 0; color: var(--phux-text-text); font-size: var(--phux-type-micro-size); line-height: 1.7; white-space: normal; overflow-wrap: anywhere; }
  .install-copy { min-height: var(--phux-space-touch-min); border: 0; padding: 0; color: var(--phux-text-dim); background: none; font-family: var(--font-reading); font-size: var(--phux-type-micro-size); cursor: pointer; }
  .install-download { display: flex; flex-wrap: wrap; gap: var(--phux-space-s1) var(--phux-space-s4); }
  .install-download a, .linux-rune-archives a { color: var(--phux-text-text); font-size: var(--phux-type-caption-size); text-decoration: underline; text-underline-offset: 4px; }
  .linux-rune { max-width: 560px; margin-top: 14px; padding: var(--phux-space-s3) var(--phux-space-s4); border: var(--phux-space-hairline) solid var(--phux-border-base); border-radius: var(--phux-radius-md); background: var(--phux-layer-sidebar); }
  .linux-rune-title { margin: 0; color: var(--phux-text-text); font-size: var(--phux-type-caption-size); font-weight: var(--phux-weight-semibold); }
  .linux-rune-line { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; }
  .linux-rune code { min-width: 0; color: var(--phux-text-text); font-size: var(--phux-type-caption-size); line-height: 1.7; overflow-wrap: anywhere; }
  .linux-rune-copy { min-height: var(--phux-space-touch-min); border: 0; padding: 0; color: var(--phux-text-dim); background: none; font-family: var(--font-reading); font-size: var(--phux-type-micro-size); cursor: pointer; }
  .linux-rune-copy:hover { color: var(--phux-text-text); }
  .linux-rune-archives { display: flex; flex-wrap: wrap; align-items: center; gap: var(--phux-space-s1) var(--phux-space-s4); margin: 0; color: var(--phux-text-faint); font-size: var(--phux-type-micro-size); }
  .linux-rune-archives a { display: inline-flex; align-items: center; min-height: var(--phux-space-s8); }
  .linux-rune-status { min-height: 0; margin: var(--phux-space-s1) 0 0; color: var(--phux-text-dim); font-size: var(--phux-type-micro-size); }
  .linux-rune-status:empty { display: none; }
  .install-request { grid-area: 1 / 1; padding-block: 10px; min-width: 0; }
  .install-note { min-height: 3.2em; margin: 10px 0 0; color: var(--phux-text-faint); font-size: var(--phux-type-micro-size); line-height: 1.6; }
  .copy-status { min-height: var(--phux-space-s5); margin: 3px 0 0; color: var(--phux-text-dim); font-size: var(--phux-type-micro-size); }
  .release-links { display: flex; flex-wrap: wrap; gap: var(--phux-space-s1) 14px; margin: 10px 0 0; color: var(--phux-text-faint); font-size: var(--phux-type-micro-size); }
  .release-links a { display: inline-flex; align-items: center; min-height: var(--phux-space-s8); }
  .closing { display: flex; align-items: center; justify-content: space-between; gap: var(--phux-space-s10); margin-top: 100px; padding-block: 62px; border-top: var(--phux-space-hairline) solid var(--phux-border-base); border-bottom: var(--phux-space-hairline) solid var(--phux-border-base); }
  .closing h2 { margin: 0; color: var(--phux-text-text); font-size: clamp(var(--phux-type-display-size), 3.6vw, 2.75rem); line-height: 1.1; font-weight: var(--phux-weight-semibold); letter-spacing: -.035em; }
  .closing-command { display: flex; gap: var(--phux-space-s2); align-items: baseline; margin: 18px 0 22px; color: var(--phux-text-text); font-size: var(--phux-type-label-size); line-height: 1.5; }
  .closing-platforms { display: inline-flex; align-items: center; min-height: var(--phux-space-touch-min); margin-inline-start: var(--phux-space-s6); color: var(--phux-text-dim); font-size: var(--phux-type-caption-size); }
  .closing-fox { flex: none; width: 280px; height: 280px; object-fit: contain; }
  .connection-details { margin-top: 28px; margin-bottom: var(--phux-space-s12); }
  .connection-details > summary { display: flex; justify-content: space-between; align-items: center; min-height: 52px; color: var(--phux-text-faint); font-size: var(--phux-type-caption-size); list-style: none; cursor: pointer; }
  .connection-details > summary::-webkit-details-marker { display: none; }
  .connection-details > summary > span { font-size: var(--phux-type-title-size); transition: transform var(--phux-motion-control-duration) var(--phux-motion-control-easing); }
  .connection-details[open] > summary > span { transform: rotate(45deg); }
  .terminal { margin-top: var(--phux-space-s4); }
  [hidden] { display: none !important; }
  @media (max-width: 900px) {
    .home { padding-inline: 28px; }
    .hero-intro { gap: 0; grid-template-columns: 1.1fr 1fr; }
    .hero-art { margin-inline: -36px -20px; }
    h1 { font-size: clamp(var(--phux-type-display-size), 4.8vw, 3rem); }
    .closing-fox { width: 220px; height: 220px; }
  }
  @media (max-width: 650px) {
    .home { padding-inline: var(--phux-space-s5); }
    .hero { padding-top: 18px; }
    .hero-intro { grid-template-columns: 1fr; gap: 0; margin-bottom: var(--phux-space-s6); }
    .hero-copy { padding-block: var(--phux-space-s3) 0; }
    .hero-art { width: min(100%, 340px); margin: -28px auto -24px; }
    h1 { max-width: none; margin-bottom: var(--phux-space-s3); font-size: clamp(var(--phux-type-display-size), 8.4vw, 2.625rem); }
    .hero-description { margin-bottom: var(--phux-space-s4); font-size: var(--phux-type-lead-size); line-height: 1.5; }
    .download-actions { gap: var(--phux-space-s3); }
    .download-primary { min-height: 52px; gap: var(--phux-space-s4); padding-inline: var(--phux-space-s4); }
    .download-note { margin-top: 10px; }
    .closing { position: relative; margin-top: var(--phux-space-s16); padding-block: var(--phux-space-s10); overflow: hidden; }
    .closing h2 { font-size: clamp(var(--phux-type-display-size), 8vw, 2.125rem); }
    .closing-fox { display: none; }
    .closing-platforms { margin: 10px 0 0; display: flex; width: fit-content; }
    .connection-details { margin-top: 18px; }
    .install-stage { min-height: 112px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .download-primary, .download-final, .install-tabs::before { transition: none; }
    .download-primary:hover, .download-final:hover { transform: none; }
  }
  @media (scripting: none) { .install-head, .install-copy { display: none; } .install-line { grid-template-columns: 1fr; } }
</style>
