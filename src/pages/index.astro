---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthReturn from "../components/AuthReturn.astro";
import HeroDemo from "../components/HeroDemo";
import ClientComparison from "../components/ClientComparison.astro";
import Fox from "../components/fox/Fox.astro";
import MobileAccessForm from "../components/MobileAccessForm.astro";
import LiveWorkspaceSection from "../components/LiveWorkspaceSection.astro";
import { SITE, docsHref } from "../lib/site";
import { cliInstall, desktopDownload, desktopFirstOpen, desktopInstall, installTargets } from "../lib/install";
import release from "../lib/release.json";
import brand from "../../brand.lock.json";
import { installActions } from "../lib/home-platform";
const installs = installTargets;
const fallback = installActions.unknown;
---

<BaseLayout minimal>
  <AuthReturn slot="head" />
  <div class="home">
    <section class="hero" aria-labelledby="product-name">
      <div class="hero-intro">
        <div class="hero-copy">
        <h1 id="product-name">phux</h1>
        <div class="hero-decision">
          <p class="hero-description">A terminal multiplexer whose server you can drive from code.</p>
          <p class="hero-body">Shells run in a background server. Attach from the terminal UI, the desktop app, or a script: every action is also a command with JSON output and an exit code. phux tracks which panes run a coding agent and whether it is waiting on you.</p>
          <div class="download-actions">
            <a class="download-primary" data-device-install href={fallback.href}><span data-device-label>{fallback.label}</span> <span data-device-icon aria-hidden="true">{fallback.icon}</span></a>
            <a class="try-link" href="#live-workspace" aria-label="Open the browser demo">Try it first <span aria-hidden="true">↗</span></a>
          </div>
          <p class="download-note">{fallback.note}</p>
      <details class="install-options" id="install-options"><summary>All platforms</summary>
      <div class="install" id="install" data-install aria-label="Install phux">
        <div class="install-head">
          <div class="install-tabs" role="group" aria-label="Choose an install">
            {installs.map((target, index) => (
              <button
                type="button"
                data-install-target={target.id}
                data-install-command={target.command}
                data-install-note={target.id === "desktop" ? desktopFirstOpen : target.id === "mobile" ? "iPhone: TestFlight · Android: Google Play testing" : target.note}
                aria-pressed={index === 0 ? "true" : "false"}
              >{target.label}</button>
            ))}
          </div>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <div class="install-stage">
          <div class="install-line">
            <span class="install-command">
              <span class="install-prompt" aria-hidden="true">$</span>
              <code id="install-command">{cliInstall}</code>
            </span>
            <a class="install-download" id="install-download" href={desktopDownload} hidden>Download for Mac ↓</a>
            <button type="button" class="install-copy" data-copy={cliInstall} aria-label="Copy install command">Copy</button>
          </div>
          <div class="install-request mobile-access" data-mobile-access hidden>
            <MobileAccessForm />
          </div>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <p class="install-note" id="install-note">{installs[0].note}</p>
        <p class="copy-status" id="beta-note" role="status" aria-live="polite"></p>
      </div>
        <p class="release-links">
          {release.url && <a href={release.url}>CLI {release.tag}</a>}
          {release.desktop.url && <a href={release.desktop.url}>Desktop {release.desktop.tag?.replace("desktop-", "")}</a>}
          <a href={docsHref("/installation")}>Installation guide ↗</a>
        </p>
      </details>
        </div>
        </div>
        <div class="hero-art"><Fox /></div>
      </div>
      <ClientComparison />
    </section>

    <section class="workflow-proof" aria-label="What phux does">
      <a href={docsHref("/agents")}>
        <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v2" /></svg>
        <h2>Agent status per pane.</h2>
        <p>phux knows which pane runs Claude Code, pi, Oh My Pi, OpenCode or Grok, and whether it is working, idle or blocked on you.</p>
        <span class="proof-link">Coding agents <span aria-hidden="true">↗</span></span>
      </a>
      <a href={docsHref("/remote")}>
        <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
        <h2>Remote machines.</h2>
        <p><code>phux host add me@mini</code> adds another machine's server. No account.</p>
        <span class="proof-link">Remote machines <span aria-hidden="true">↗</span></span>
      </a>
      <a href={docsHref("/clients")}>
        <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="2" /><path d="M7 16v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-2" /></svg>
        <h2>Detach and reattach.</h2>
        <p>Close the TUI or the app; shells and agents keep running on the server. A crash or reboot ends them.</p>
        <span class="proof-link">Clients <span aria-hidden="true">↗</span></span>
      </a>
    </section>
  </div>

  <LiveWorkspaceSection />

  <section class="closing home" aria-labelledby="closing-title">
    <div class="closing-copy">
      <h2 id="closing-title">Install</h2>
      <p class="closing-command"><span class="install-prompt" aria-hidden="true">$</span> <code>{cliInstall}</code></p>
      <a class="download-final" data-device-install href={fallback.href}><span data-device-label>{fallback.label}</span> <span data-device-icon aria-hidden="true">{fallback.icon}</span></a>
      <a class="closing-platforms" href={docsHref("/installation")}>All platforms ↗</a>
    </div>
    <img class="closing-fox" src={`/brand/images/fox.svg?v=${brand.version}`} width="340" height="340" alt="" aria-hidden="true" loading="lazy" />
  </section>

  <details class="connection-details home" id="connection-details">
    <summary>How your workspace stays connected <span aria-hidden="true">+</span></summary>
    <section class="terminal" aria-label="How clients share the workspace"><HeroDemo client:visible wsUrl={SITE.demoWsUrl} /></section>
  </details>
  <div hidden data-webmcp data-product={SITE.name} data-cli={cliInstall}
    data-desktop={desktopInstall} data-docs={SITE.docsUrl}
    data-release-tag={release.tag} data-release-url={release.url}></div>
</BaseLayout>

<script>
  import { registerSiteTools, siteModelContext } from "../webmcp.ts";
  import { wireBetaRequest } from "../lib/beta.ts";
  import { wireInstallTargets } from "../lib/home-install";
  import { wireDeviceInstall } from "../lib/home-platform";
  const facts = document.querySelector<HTMLElement>("[data-webmcp]");
  const context = siteModelContext(globalThis);
  if (facts && context) {
    void registerSiteTools(context, {
      productName: facts.dataset.product ?? "", cliInstall: facts.dataset.cli ?? "",
      desktopInstall: facts.dataset.desktop ?? "",
      docsUrl: facts.dataset.docs ?? "", releaseTag: facts.dataset.releaseTag ?? "",
      releaseUrl: facts.dataset.releaseUrl ?? "",
    });
  }
  // A native OAuth return must wake the otherwise visibility-hydrated dialog.
  if (document.documentElement.dataset.nativeAuthResult) {
    document.querySelector<HTMLDetailsElement>("#connection-details")!.open = true;
    document.querySelector(".terminal")?.scrollIntoView({ block: "center", behavior: "instant" });
  }
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>(".copy-status");
  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      if (status) status.textContent = "Install command copied.";
      setTimeout(() => { button.textContent = button.dataset.label ?? "Copy"; }, 1400);
    } catch {
      if (status) status.textContent = "Could not copy. Select the command to copy it manually.";
    }
  });

  // The dock keeps its fixed width and reserves its stage height, so a swap
  // moves nothing. Only the target underline travels (transform), and the
  // command settles with opacity and a short translate. The Mobile target has
  // no command: it swaps the command line for the beta request form. No
  // clip or backdrop animation: both are what made the first pass stutter.
  wireInstallTargets(button);

  wireBetaRequest(
    document.getElementById("beta-form") as HTMLFormElement | null,
    document.getElementById("beta-note"),
    document.getElementById("beta-phone") as HTMLButtonElement | null,
  );
  wireDeviceInstall();
</script>

<style>
  .home { width: min(100%, 1240px); margin-inline: auto; padding-inline: 40px; box-sizing: border-box; }
  .hero { padding-top: 28px; }
  .hero-intro { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 12px; margin-bottom: 32px; }
  .hero-copy { position: relative; z-index: 1; padding-block: 22px; }
  .hero-art { margin: -24px -38px -20px -36px; pointer-events: none; overflow: clip; }
  h1 { margin: 0 0 14px; color: #e7e2da; font-size: clamp(54px, 6.5vw, 88px); line-height: .99; font-weight: 450; letter-spacing: -.065em; }
  .hero-description { margin: 0 0 12px; color: #bdc2be; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.45; letter-spacing: -.015em; }
  .hero-body { margin: 0 0 18px; max-width: 62ch; color: #9ca79f; font-size: 15px; line-height: 1.5; }
  .download-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 20px; }
  .download-primary, .download-final { display: inline-flex; align-items: center; justify-content: center; gap: 28px; min-height: 56px; padding: 0 24px; border: 1px solid #efeadf; border-radius: 8px; background: #e7e2da; color: #171a1e; font-size: 14px; font-weight: 650; line-height: 1.2; box-shadow: 0 1px #fff8 inset, 0 5px 20px #0003; transition: background 160ms, transform 160ms, box-shadow 160ms; }
  .download-primary:hover, .download-final:hover { background: #fffaf2; color: #171a1e; transform: translateY(-1px); box-shadow: 0 1px #fff inset, 0 7px 28px #0005; }
  [data-device-icon] { font-size: 20px; font-weight: 400; }
  .try-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: #adb5b0; font-size: 13px; }
  .try-link:hover { color: #f0ebe3; }
  .closing-command code { color: #dce4dc; font-size: 11px; overflow-wrap: anywhere; }
  .download-note { margin: 12px 0 0; color: #8d9692; font-size: 11px; letter-spacing: .01em; }
  .install-options { margin-top: 8px; }
  .install-options > summary { width: fit-content; min-height: 44px; display: flex; align-items: center; gap: 10px; color: #aab2ad; font-size: 12px; cursor: pointer; list-style: none; }
  .install-options > summary::after { content: "+"; color: #838d87; }
  .install-options[open] > summary::after { content: "−"; }
  .install-options > summary::-webkit-details-marker { display: none; }
  .install { position: relative; width: 100%; box-sizing: border-box; padding: 14px 18px 0; border: 1px solid #c8cfc322; border-radius: 10px; background: #171a1eb3; }
  .install-tabs { position: relative; display: flex; gap: 6px; }
  .install-tabs::before { content: ""; position: absolute; bottom: -5px; left: 0; width: var(--pill-width, 0); height: 1px; background: #d9e0d7; opacity: .65; transform: translateX(var(--pill-x, 0)); transition: transform 300ms ease; }
  .install-tabs button { position: relative; min-width: 64px; min-height: 44px; padding: 0 8px; border: 0; background: none; color: #8c9891; font: inherit; font-size: 12px; cursor: pointer; }
  .install-tabs button[aria-pressed=true], .install-tabs button:hover { color: #efeae1; }
  .install-rule { display: block; height: 1px; margin-top: 14px; background: #c8cfc31c; }
  .install-stage { display: grid; align-items: center; min-height: 112px; }
  .install-line { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; padding-top: 10px; }
  .install-command { display: flex; gap: 8px; align-items: start; min-width: 0; }
  .install-prompt { color: #a9d2b5; font: 12px var(--font-code); }
  #install-command { min-width: 0; color: #dce4dc; font-size: 11px; line-height: 1.7; white-space: normal; overflow-wrap: anywhere; }
  .install-copy { min-height: 44px; border: 0; padding: 0; color: #aab4ad; background: none; font: 11px var(--font-reading); cursor: pointer; }
  .install-download { color: #e7e2da; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  .install-request { grid-area: 1 / 1; padding-block: 10px; min-width: 0; }
  .install-note { min-height: 3.2em; margin: 10px 0 0; color: #919e95; font-size: 11px; line-height: 1.6; }
  .copy-status { min-height: 20px; margin: 3px 0 0; color: #c3d6c6; font-size: 11px; }
  .release-links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 10px 0 0; color: #8f9c92; font-size: 10px; }
  .release-links a { display: inline-flex; align-items: center; min-height: 32px; }
  .workflow-proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin: 72px 0 0; padding: 48px 0 8px; border-top: 1px solid #bccbc01f; }
  .workflow-proof > a { display: flex; flex-direction: column; align-items: start; color: inherit; }
  .proof-icon { display: block; width: 38px; height: 38px; padding: 8px; margin-bottom: 24px; border: 1px solid #c8d0c025; border-radius: 10px; background: #c8d0c006; color: #c7d8cb; }
  .workflow-proof h2 { margin: 0; font-size: clamp(22px, 2.2vw, 29px); font-weight: 500; line-height: 1.2; letter-spacing: -.04em; color: #e7e2da; }
  .workflow-proof p { margin: 16px 0 20px; max-width: 42ch; color: #9ca79f; font-size: 14px; line-height: 1.7; }
  .workflow-proof code { color: #dce4dc; font-size: 12px; }
  .proof-link { margin-top: auto; display: inline-flex; align-items: center; gap: 18px; min-height: 44px; color: #becfc2; font-size: 12px; }
  .workflow-proof a:hover .proof-link { color: #f0ebe3; }
  .closing { display: flex; align-items: center; justify-content: space-between; gap: 40px; margin-top: 100px; padding-block: 62px; border-top: 1px solid #c8d0c025; border-bottom: 1px solid #c8d0c025; }
  .closing h2 { margin: 0; color: #e7e2da; font-size: clamp(32px, 4vw, 52px); line-height: 1.1; font-weight: 500; letter-spacing: -.05em; }
  .closing-command { display: flex; gap: 8px; align-items: baseline; margin: 18px 0 22px; color: #dce4dc; font-size: 13px; line-height: 1.5; }
  .closing-platforms { display: inline-flex; align-items: center; min-height: 44px; margin-left: 24px; color: #a8b8ad; font-size: 12px; }
  .closing-fox { flex: none; width: 280px; height: 280px; object-fit: contain; }
  .connection-details { margin-top: 28px; margin-bottom: 48px; }
  .connection-details > summary { display: flex; justify-content: space-between; align-items: center; min-height: 52px; color: #8f9e94; font-size: 12px; list-style: none; cursor: pointer; }
  .connection-details > summary::-webkit-details-marker { display: none; }
  .connection-details > summary > span { font-size: 20px; }
  .connection-details[open] > summary > span { transform: rotate(45deg); }
  .terminal { margin-top: 16px; }
  [hidden] { display: none !important; }
  a:focus-visible, button:focus-visible, summary:focus-visible, input:focus-visible { outline: 2px solid #c1dbc8; outline-offset: 4px; }
  @media (max-width: 900px) {
    .home { padding-inline: 28px; }
    .hero-intro { gap: 0; grid-template-columns: 1.1fr 1fr; }
    .hero-art { margin-inline: -36px -20px; }
    h1 { font-size: clamp(48px, 7vw, 68px); }
    .hero-description { font-size: 15px; }
    .workflow-proof { gap: 28px; }
    .workflow-proof h2 { font-size: 23px; }
    .closing-fox { width: 220px; height: 220px; }
  }
  @media (max-width: 650px) {
    .home { padding-inline: 20px; }
    .hero { padding-top: 18px; }
    .hero-intro { grid-template-columns: 1fr; gap: 0; margin-bottom: 24px; }
    .hero-copy { padding-block: 12px 0; }
    .hero-art { width: min(100%, 340px); margin: -20px auto -20px; }
    h1 { font-size: clamp(52px, 11vw, 70px); }
    .hero-description { margin-bottom: 10px; font-size: 16px; }
    .hero-body { margin-bottom: 14px; font-size: 14px; line-height: 1.45; }
    h1 { margin-bottom: 10px; }
    .download-actions { gap: 12px; }
    .download-primary { min-height: 52px; gap: 16px; padding-inline: 16px; }
    .download-note { margin-top: 10px; }
    .workflow-proof { grid-template-columns: 1fr; gap: 32px; margin-top: 48px; padding-top: 32px; }
    .workflow-proof > a { display: grid; grid-template-columns: 44px 1fr; gap: 0 18px; }
    .proof-icon { grid-row: 1 / 4; margin: 2px 0 0; }
    .workflow-proof h2 { font-size: 25px; }
    .workflow-proof p { margin: 12px 0 8px; }
    .proof-link { grid-column: 2; }
    .closing { position: relative; margin-top: 64px; padding-block: 40px; overflow: hidden; }
    .closing h2 { font-size: 34px; }
    .closing-fox { display: none; }
    .closing-platforms { margin: 10px 0 0; display: flex; width: fit-content; }
    .connection-details { margin-top: 18px; }
    .install-stage { min-height: 112px; }
  }
  @media (prefers-reduced-motion: reduce) { .download-primary, .download-final, .install-tabs::before { transition: none; } }
  @media (scripting: none) { .install-head, .install-copy { display: none; } .install-line { grid-template-columns: 1fr; } }
</style>
