---
// The phone half of the demo pairing link (see components/PhonePair.tsx).
//
// Reached by scanning the QR printed by `phux pair` in the hosted terminal:
// the code rides in the URL fragment, the page attaches this screen to the
// same session, and the visitor is driving a shell on their phone in a second.
// The app stays one tap away for the machines they actually own.
import BaseLayout from "../layouts/BaseLayout.astro";
import PhonePair from "../components/PhonePair";
import { SITE } from "../lib/site";
---

<BaseLayout
  title={`Your phone — ${SITE.name}`}
  description={`Attach this phone's browser to a ${SITE.name} demo shell — no install, no sign-in.`}
  minimal
>
  <div class="phone">
    <div class="phone-head">
      <h1>Your phone, same shell</h1>
      <a class="phone-app" href="/more#testflight" target="_blank" rel="noreferrer">
        Get the app <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="phone-lede">
      Scanning attached <em>this</em> browser to the shell on your screen. Type
      here and the other screen sees it. The iPhone app is in TestFlight, and
      connects to the machines you own.
    </p>
    <PhonePair client:only="react" wsUrl={SITE.demoWsUrl} />
  </div>
</BaseLayout>

<style>
  .phone { width: min(100%, 620px); margin: auto; padding-inline: 16px; box-sizing: border-box; display: grid; gap: 12px; align-content: start; }
  .phone-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 18px; }
  .phone-head h1 { margin: 0; font-size: 22px; font-weight: 650; letter-spacing: -0.03em; }
  .phone-app { flex: none; display: inline-flex; align-items: center; gap: 5px; min-height: 32px; padding: 0; color: var(--color-signal); font-size: 13px; font-weight: 600; text-decoration: none; }
  .phone-app:hover { text-decoration: underline; text-underline-offset: 3px; }
  .phone-app:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; border-radius: 4px; }
  .phone-lede { margin: 0 0 6px; color: var(--color-muted); font-size: 13px; line-height: 1.6; }
  .phone-lede em { color: var(--color-fg); font-style: normal; font-weight: 600; }
  @media (max-width: 420px) {
    .phone-head { align-items: flex-start; flex-direction: column; gap: 6px; }
    .phone-app { min-height: 40px; }
  }
</style>
